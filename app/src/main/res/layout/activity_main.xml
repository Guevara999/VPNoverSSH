    <!-- Custom Payload and Remote Proxy Input Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Custom HTTP Payload:"
            android:textStyle="bold"
            android:textColor="#000000" />

        <EditText
            android:id="@+id/editPayload"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="GET / HTTP/1.1[crlf]Host: [rotate=...]"
            android:gravity="top|left"
            android:background="#EAEAEA"
            android:padding="8dp"
            android:inputType="textMultiLine"
            android:scrollbars="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Remote Proxy (ip:port or host:port):"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/editRemoteProxy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="://oppo.com"
            android:background="#EAEAEA"
            android:padding="8dp"
            android:inputType="textUri" />
    </LinearLayout>
